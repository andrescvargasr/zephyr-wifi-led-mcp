menu "WS2812 Configuration"

config SAMPLE_LED_UPDATE_DELAY
	int "Delay between LED updates in ms"
	default 50
	help
	  Delay between LED updates in ms.

config LED_MATRIX_WIDTH
	int "Width of the LED matrix"
	default 16
	range 1 255
	help
	  Width of the LED matrix.

config LED_MATRIX_HEIGHT
	int "Height of the LED matrix"
	default 16
	range 1 255
	help
	  Height of the LED matrix.

config LED_MATRIX_PIXELS
	int "Number of pixels in the LED matrix"
	default 256
	range 1 65536
	help
	  Number of pixels in the LED matrix.

config WHITE_LED_BRIGHTNESS
	int "White LED brightness"
	default 25
	range 1 255
	help
	  Brightness level of the white LED settings (all RGB on). Defaults to a low value to avoid blinding
	  the user and issue with the power supply, due to the WS2812 LEDs draw more current when all are on.

config DEFAULT_LED_BRIGHTNESS
	int "Default LED brightness"
	default 25
	range 1 255
	help
	  Brightness level of each LED. Defaults to a low value to make
	  it easier to distinguish colors.

endmenu

menu "HTTP Service Configuration"

config NET_SAMPLE_HTTP_SERVICE
	bool "Enable http service"
	default y

config NET_SAMPLE_HTTP_SERVER_SERVICE_PORT
	int "Port number for http service"
	default 80
	depends on NET_SAMPLE_HTTP_SERVICE

endmenu

source "Kconfig.zephyr"
